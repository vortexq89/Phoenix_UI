package-as: Phoenix_UI

move-folders:
  Phoenix_UI/Phoenix_UI_Sentinel: Phoenix_UI_Sentinel
  Phoenix_UI/Phoenix_UI_Options: Phoenix_UI_Options
  Phoenix_UI/Phoenix_UI_UnitFrames: Phoenix_UI_UnitFrames
  Phoenix_UI/Phoenix_UI_ResourceBars: Phoenix_UI_ResourceBars
  Phoenix_UI/Phoenix_UI_ActionBars: Phoenix_UI_ActionBars
  Phoenix_UI/Phoenix_UI_Nameplates: Phoenix_UI_Nameplates
  Phoenix_UI/Phoenix_UI_RaidFrames: Phoenix_UI_RaidFrames
  Phoenix_UI/Phoenix_UI_CooldownManager: Phoenix_UI_CooldownManager
  Phoenix_UI/Phoenix_UI_HUD: Phoenix_UI_HUD
  Phoenix_UI/Phoenix_UI_Chat: Phoenix_UI_Chat
  Phoenix_UI/Phoenix_UI_Skins: Phoenix_UI_Skins
  Phoenix_UI/Phoenix_UI_Vault: Phoenix_UI_Vault
  Phoenix_UI/Phoenix_UI_Flow: Phoenix_UI_Flow
  Phoenix_UI/Phoenix_UI_QuestTracker: Phoenix_UI_QuestTracker
  Phoenix_UI/Phoenix_UI_Reminders: Phoenix_UI_Reminders
  Phoenix_UI/Phoenix_UI_Setup: Phoenix_UI_Setup

externals:
  Libs/LibStub:
    url: https://repos.curseforge.com/wow/libstub/trunk
    tag: latest
  Libs/CallbackHandler-1.0:
    url: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
    tag: latest
  Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate
    tag: latest

ignore:
  - .tools
  - .github
  - docs
  - Data/ApiCatalog.json
  - companion
  - README.md
